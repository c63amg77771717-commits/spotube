    "All preferences (playback, audio, language, privacy) will return to defaults. Your playlists, history, downloads, and account are not affected." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All preferences (playback, audio, language, privacy) will return to defaults. Your playlists, history, downloads, and account are not affected."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての設定（再生、オーディオ、言語、プライバシー）がデフォルトに戻ります。プレイリスト、履歴、ダウンロード、アカウントには影響しません。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tất cả tùy chọn (phát lại, âm thanh, ngôn ngữ, quyền riêng tư) sẽ trở về mặc định. Danh sách phát, lịch sử, bản tải xuống và tài khoản của bạn không bị ảnh hưởng."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放、音訊、語言及隱私偏好將還原為預設值。歌單、紀錄、下載與帳號不受影響。"
          }
        }
      }
    },
